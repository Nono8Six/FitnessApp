<resources>
    <color name="fitness_accent">#B4F000</color>
    <style name="FitnessHealth" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">@color/fitness_accent</item>
        <item name="android:alertDialogTheme">@style/FitnessHealthDialog</item>
    </style>
    <style name="FitnessHealthDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/fitness_accent</item>
        <item name="android:colorBackground">#1C1C1E</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/FitnessDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/FitnessDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/FitnessDialogButton</item>
    </style>
    <style name="FitnessDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/fitness_accent</item>
    </style>
</resources>
