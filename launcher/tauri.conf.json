{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fitness Launcher",
  "version": "0.1.0",
  "identifier": "fr.fitness.local.launcher",
  "build": { "frontendDist": "../frontend/dist-launcher" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "url": "launcher.html", "title": "Fitness · Serveur", "width": 640, "height": 780,
      "minWidth": 420, "minHeight": 640, "center": true, "theme": "Dark",
      "backgroundColor": "#000000", "devtools": false
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "capabilities": []
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
